# 本地 API 端口
PORT=8787

# 必填：访客凭据与 token 哈希的 HMAC 密钥（部署时换成 32+ 位随机串）
AUTH_SECRET=replace-with-a-long-random-secret

# 可选：PostgreSQL 连接串。留空时使用 server/data/db.json，仅适合本地单实例试玩。
# DATABASE_URL=postgres://user:password@host:5432/lumen?sslmode=require
# PG_SSL=false

# 分享链接与预览使用的前端地址
PUBLIC_APP_URL=http://localhost:5173/city.html

# CORS 允许来源；本地开发用 *
ALLOW_ORIGIN=*
